rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil et progression : chaque membre ne lit et n'écrit que le sien
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Forum : lecture publique, écriture réservée aux membres connectés
    match /threads/{tid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() >= 10 && request.resource.data.body.size() <= 4000;
      // Seul le compteur de réponses peut évoluer, et seulement de +1
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount == resource.data.replyCount + 1;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /replies/{rid} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 4000;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      }
    }
  }
}
